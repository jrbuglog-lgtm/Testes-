        <div class="palette-card" onclick="selectPalette('Pastel')">
            <div class="palette-name">Pastel</div>
            <div class="colors-row">
                <div class="color-block" style="background: #FFB3BA;">
                    <span class="color-code">#FFB3BA</span>
                </div>
                <div class="color-block" style="background: #FFDFBA;">
