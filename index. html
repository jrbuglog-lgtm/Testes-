                </div>
            </div>
            <button class="btn-select">Selecionar Paleta</button>
        </div>

        <div class="palette-card" onclick="selectPalette('Forest')">
            <div class="palette-name">Forest</div>
            <div class="colors-row">
                <div class="color-block" style="background: #2D6A4F;">
                    <span class="color-code">#2D6A4F</span>
                </div>
                <div class="color-block" style="background: #40916C;">
                    <span class="color-code">#40916C</span>
                </div>
                <div class="color-block" style="background: #52B788;">
                    <span class="color-code">#52B788</span>
                </div>
                <div class="color-block" style="background: #74C69D;">
