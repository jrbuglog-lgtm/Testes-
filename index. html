                </div>
                <div class="color-block" style="background: #BAE1FF;">
                    <span class="color-code">#BAE1FF</span>
                </div>
            </div>
            <button class="btn-select">Selecionar Paleta</button>
        </div>

    </div>

    <footer>
        © 2026 Color Palettes. Feito com 💜 para designers.
    </footer>

    <script>
        function selectPalette(name) {
            alert('Você selecionou a paleta: ' + name + '\nEm breve mais funcionalidades!');
        }

        // Copiar cor ao clicar no bloco
        document.querySelectorAll('.color-block').forEach(block => {
            block.addEventListener('click', (e) => {
                e.stopPropagation();
                const code = block.querySelector('.color-code').textContent;
                navigator.clipboard.writeText(code).then(() => {
                    // Feedback visual sutil
                    block.style.transform = 'scale(1.1)';
                    setTimeout(() => block.style.transform = 'scale(1)', 200);
                });
            });
        });
    </script>

</body>
</html>
